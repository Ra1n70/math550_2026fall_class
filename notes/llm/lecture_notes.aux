\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Attention as soft retrieval. Similarity between the query and each key sets the mixture weight on the corresponding value. Queries and memory may come from different sources, so attention is not automatically self-attention.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:attention-retrieval}{{1}{7}{Attention as soft retrieval. Similarity between the query and each key sets the mixture weight on the corresponding value. Queries and memory may come from different sources, so attention is not automatically self-attention}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Self-attention for one head. The $T\times T$ matrix contains one row of attention weights for each query position and one column for each key/value position. The weighted values produce a new contextual representation at every token position.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:self-attention-flow}{{2}{8}{Self-attention for one head. The $T\times T$ matrix contains one row of attention weights for each query position and one column for each key/value position. The weighted values produce a new contextual representation at every token position}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The lower-triangular causal mask. Blue cells are visible; coral cells are future positions excluded before softmax. The diagonal remains visible so a hidden state at position $i$ can represent token $x_i$ while predicting $x_{i+1}$.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:causal-mask}{{3}{8}{The lower-triangular causal mask. Blue cells are visible; coral cells are future positions excluded before softmax. The diagonal remains visible so a hidden state at position $i$ can represent token $x_i$ while predicting $x_{i+1}$}{figure.3}{}}
